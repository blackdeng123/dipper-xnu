+/* Stage 9: observe the ADSP GLINK handshake without starting a speaker path. */
+static bool
+audio_glink_item(__unused void *ctx, uint32_t item, uint32_t *offset, uint32_t *size)
+{
+	uint32_t cacheline = 0, psize = 0, at;
+	uint32_t partition = smem_partition(SMEM_US, SMEM_ADSP, &cacheline, &psize);
+	if (partition == 0 || (at = item_find(partition, cacheline, item, size)) == 0) return false;
+	*offset = at;
+	return true;
+}
+
+static void
+audio_glink_ring(__unused void *ctx)
+{
+	ring(1u << 8); /* qcom,glink-smem-native-xprt-adsp qcom,irq-mask */
+}
+
+static bool
+audio_glink_prepare(void)
+{
+	static const struct { uint32_t item, size; } items[] = { { 478, 32 }, { 479, 16384 } };
+	uint32_t cacheline = 0, psize = 0, size = 0;
+	uint32_t partition = smem_partition(SMEM_US, SMEM_ADSP, &cacheline, &psize);
+	if (partition == 0 || item_find(partition, cacheline, ITEM_SMP2P_THEIRS, &size) != 0) {
+		say("mi8rp: audio-glink: no partition or ADSP already ran; refusing\n");
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(items) / sizeof(items[0]); i++) {
+		uint32_t at;
+		if (item_find(partition, cacheline, items[i].item, &size) != 0 || !lock_take()) {
+			say("mi8rp: audio-glink: item %u exists or lock unavailable; refusing\n", items[i].item);
+			return false;
+		}
+		bool made = item_make_locked(partition, items[i].item, items[i].size);
+		lock_give();
+		at = made ? item_find(partition, cacheline, items[i].item, &size) : 0;
+		if (at == 0 || size != items[i].size) return false;
+		for (uint32_t off = 0; off < size; off += 4) smem_poke(at + off, 0);
+		settle();
+		say("mi8rp: audio-glink: created item %u (%u bytes)\n", items[i].item, size);
+	}
+	return true;
+}
+
+static void
+audio_glink_probe(void)
+{
+	struct mi8_glink_cfg cfg;
+	struct mi8_glink *link;
+	bool started = false;
+	bzero(&cfg, sizeof(cfg));
+	cfg.name = "adsp";
+	cfg.remote_pid = SMEM_ADSP;
+	cfg.smem_item = audio_glink_item;
+	cfg.smem_read = svc_read;
+	cfg.smem_write32 = svc_write32;
+	cfg.ring = audio_glink_ring;
+	cfg.sleep_us = svc_sleep_us;
+	cfg.now_us = svc_now_us;
+	cfg.log = svc_log;
+	link = mi8_glink_create(&cfg);
+	if (link == NULL) {
+		say("mi8rp: audio-glink: cannot allocate link\n");
+		return;
+	}
+	for (unsigned i = 0; i < 500; i++) {
+		uint32_t offset, size;
+		if (!started && audio_glink_item(NULL, 480, &offset, &size)) {
+			started = mi8_glink_start(link) == 0;
+			if (!started) break;
+			say("mi8rp: audio-glink: link started\n");
+		}
+		if (started) mi8_glink_poll_once(link);
+		delay_for_interval(10, NSEC_PER_MSEC);
+	}
+	if (!started) say("mi8rp: audio-glink: no remote FIFO or link could not start\n");
+	mi8_glink_destroy(link);
+	say("mi8rp: audio-glink: probe ended; DSP stop follows\n");
+}
