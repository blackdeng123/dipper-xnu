+int
+mi8_glink_raw_send(struct mi8_glink *g, const void *data, size_t length)
+{
+	struct outgoing *o;
+	int error;
+	if (g == NULL || data == NULL || length == 0) return EINVAL;
+	if (length > MI8_GLINK_MAX_DATAGRAM) return EMSGSIZE;
+	enter(g);
+	if (g->cfg.raw_channel == NULL) { leave(g); return EINVAL; }
+	if (!g->up || !g->opened || g->broken) { leave(g); return ENOTCONN; }
+	o = queue_raw(g, data, (uint32_t)length);
+	if (o == NULL) { leave(g); return ENOMEM; }
+	do {
+		pump(g); progress(g);
+		if (!o->done) g->cfg.sleep_us(g->cfg.ctx, 1000);
+	} while (!o->done);
+	error = o->error;
+	MI8_FREE(o, sizeof(*o) + o->length);
+	leave(g);
+	return error;
+}
