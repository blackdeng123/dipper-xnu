+/* APR core-service state request, using the packet layout already used by
+ * redwood_adsp.c (https://github.com/oosexgang/hackios-xnu-kernel, APSL-2.0).
+ * This does not configure an audio stream or amplifier. */
+struct audio_apr_header {
+	uint16_t field, size;
+	uint8_t from_service, from_domain;
+	uint16_t from_port;
+	uint8_t to_service, to_domain;
+	uint16_t to_port;
+	uint32_t token, opcode;
+};
+struct audio_apr_probe { bool answered; uint32_t state; };
+
+static void
+audio_apr_receive(void *ctx, const void *data, size_t length)
+{
+	struct audio_apr_probe *probe = ctx;
+	struct audio_apr_header h;
+	uint32_t state;
+	if (length < sizeof(h)) return;
+	memcpy(&h, data, sizeof(h));
+	uint32_t header_length = ((h.field >> 4) & 0xf) * 4;
+	if (header_length < sizeof(h) || header_length > length || h.size > length || h.size < header_length) return;
+	say("mi8rp: audio-apr: response opcode %#x token %u length %u\n", h.opcode, h.token, h.size);
+	if (h.token != 1 || h.opcode != 0x0001290du || h.size - header_length < sizeof(state)) return;
+	memcpy(&state, (const uint8_t *)data + header_length, sizeof(state));
+	probe->state = state;
+	probe->answered = true;
+	say("mi8rp: audio-apr: core state %u\n", state);
+}
