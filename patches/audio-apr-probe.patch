+static struct outgoing *
+queue_raw(struct mi8_glink *g, const void *p, uint32_t len)
+{
+	struct outgoing *o;
+	if (g->outgoing_count == 64 || !(o = MI8_ALLOC(sizeof(*o) + len))) return NULL;
+	memset(o, 0, sizeof(*o) + len);
+	o->length = len;
+	o->synchronous = true;
+	o->since = g->cfg.now_us(g->cfg.ctx);
+	memcpy(o->bytes, p, len);
+	if (g->outgoing_last) g->outgoing_last->next = o;
+	else g->outgoing = o;
+	g->outgoing_last = o;
+	g->outgoing_count++;
+	return o;
+}
